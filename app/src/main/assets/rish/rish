#!/system/bin/sh
BASEDIR=$(dirname "$0")
DEX="$BASEDIR"/rish_shizuku.dex

if [ ! -f "$DEX" ]; then
  echo "Cannot find $DEX, please check the tutorial in Shizuku app"
  exit 1
fi

# Resolve calling package id (defaults to com.termux)
if [ -z "$RISH_APPLICATION_ID" ]; then
  _pid=$PPID
  _i=0
  while [ -n "$_pid" ] && [ "$_pid" != "0" ] && [ "$_i" -lt 8 ]; do
    _name=$(cat "/proc/$_pid/cmdline" 2>/dev/null | tr '\0' '\n' | head -n 1 | sed 's/:.*//')
    case "$_name" in
      */*) : ;;
      *.*) export RISH_APPLICATION_ID="$_name"; break ;;
    esac
    _pid=$(grep -a '^PPid:' "/proc/$_pid/status" 2>/dev/null | sed 's/[^0-9]//g')
    _i=$((_i + 1))
  done
fi

[ -z "$RISH_APPLICATION_ID" ] && export RISH_APPLICATION_ID="com.termux"
[ -z "$MANAGER_APPLICATION_ID" ] && export MANAGER_APPLICATION_ID="moe.shizuku.privileged.api"

# Android 14+ (SDK 34+) rejects writable dex files in app_process
if [ $(getprop ro.build.version.sdk) -ge 34 ]; then
  if [ -w "$DEX" ]; then
    chmod 400 "$DEX" 2>/dev/null
    if [ -w "$DEX" ]; then
      # On FUSE/external storage (/storage/emulated/0), chmod 400 cannot remove write permission.
      # Copy to terminal app's private directory where read-only chmod 400 is respected.
      PKG="${RISH_APPLICATION_ID:-com.termux}"
      STAGE_DIR="/data/data/$PKG/files/usr/tmp"
      [ ! -d "$STAGE_DIR" ] && STAGE_DIR="/data/data/$PKG/files/home/.rish"
      mkdir -p "$STAGE_DIR" 2>/dev/null
      STAGE_DEX="$STAGE_DIR/rish_shizuku.dex"
      cp -f "$DEX" "$STAGE_DEX" 2>/dev/null
      chmod 400 "$STAGE_DEX" 2>/dev/null
      if [ -f "$STAGE_DEX" ] && [ ! -w "$STAGE_DEX" ]; then
        DEX="$STAGE_DEX"
      else
        echo "On Android 14+, app_process cannot load writable dex."
        echo "Cannot remove write permission on external storage."
        exit 1
      fi
    fi
  fi
fi

/system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
